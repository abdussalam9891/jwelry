# Backend API base URL. When unset, the app uses http://localhost:5000/api on
# localhost and the production API everywhere else.
# NEXT_PUBLIC_API_BASE=https://jwelry-backend.onrender.com/api

# Develop locally against the deployed API (whose CORS only allows the
# production site) by proxying it through the Next.js server:
# API_PROXY_TARGET=https://jwelry-backend.onrender.com/api
# NEXT_PUBLIC_API_BASE=/api
